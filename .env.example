# Copiá este archivo a .env para desarrollar. En Easypanel no se usa: las variables se cargan
# en el servicio de la app (ver docs/EASYPANEL.md). Nunca subas .env: el repositorio es público.

# Base de datos. En local podés dejarla vacía: se usa una base embebida en data/pglite.
# En Easypanel va la URL interna del servicio de Postgres.
DATABASE_URL=
DATABASE_SSL=false

# Carpeta persistente para los archivos que suben los clientes.
DIR_DATOS=./data

# Dirección pública de la app, para armar los links que se mandan por mail.
URL_PUBLICA=http://localhost:3000

# Código del link general (https://tu-dominio/?c=CODIGO). Sin él no se puede empezar un cuestionario.
CODIGO_ACCESO=

# Clave de la API de Anthropic.
ANTHROPIC_API_KEY=
# Modelo que conduce el cuestionario. Vacío = claude-sonnet-5.
MODELO_IA=
# Modelo que hace de dueño de negocio en el simulador. Vacío = claude-sonnet-5.
MODELO_PERSONA=

# Correo con Gmail: SMTP_CLAVE es una contraseña de aplicación, no la contraseña de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

SMTP_TLS=

# A quién le llega el aviso de cuestionario terminado.
MAIL_AVISO=

# Topes para que nadie gaste la API sin control. Vacíos = 20 cuestionarios nuevos por día y
# 1000 llamadas a Claude por cuestionario (cada foto que se sube es una llamada).
TOPE_CUESTIONARIOS_POR_DIA=
TOPE_LLAMADAS_POR_CUESTIONARIO=

# Audios y videos. Se escuchan en esta misma máquina con Whisper: no hace falta ninguna clave.
# En Easypanel no se carga nada de esto: la imagen ya trae ffmpeg y los modelos.
#
# ffmpeg decodifica audios y videos, saca fotogramas y convierte las fotos HEIC. Tiene que ser
# 8.1 o posterior. Vacío = el «ffmpeg» del PATH. En Windows, si no está en el PATH, la ruta
# completa: C:\ffmpeg\bin\ffmpeg.exe
RUTA_FFMPEG=
# Carpeta de los modelos de Whisper. Vacío = data/modelos, donde los deja «npm run modelo».
DIR_MODELOS=
# Modelo para transcribir. Vacío = se elige solo: whisper-small, o whisper-base si la máquina
# tiene menos de 3 GB de RAM. whisper-base usa menos memoria y se equivoca más con precios.
MODELO_TRANSCRIPCION=
# Hilos de CPU para transcribir. Vacío = hasta 2, dejando un núcleo libre para la app.
HILOS_TRANSCRIPCION=
